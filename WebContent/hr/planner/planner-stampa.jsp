  <script>
  	function control(frm) {
  		
  		var nomeFile = $('#nomeFile').val();
  		
  		var dest = $('#dest').val();
  		var ogg = $('#ogg').val();
  		var mes = $('#editor').html();
  		
  		if($.trim(dest)!='')
		{
  			
			$.ajax({
		        url: 'sendMail.jsp',
		        type: 'POST',
		        dataType: 'html',
		        data: 'dest='+dest+'&ogg='+ogg+'&mes='+mes+'&allegato='+nomeFile,
		        beforeSend: function () {
		        	
		        },
		        success: function (data) {
		        	$('#msg').html(data);
		        },
		        error: function () {
		        	alert('Errore! si e\' verificato un errore.');
		        }
		    });
			
			return false;
			
		}
  		
  	}
  	
  	
    jQuery(window).load(function() {
		jQuery('#loading-image').hide();
	});
	  
	function showLoader() {
	  jQuery('#loading-image').show();
	}
	function hideLoader() {
	  jQuery('#loading-image').hide();
	}
  </script>
